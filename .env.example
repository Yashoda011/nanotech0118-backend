# Copy to .env and adjust
# Postgres (production):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nanosphere
# Dev fallback (no postgres needed):
DATABASE_URL=sqlite:///./nanosphere.db
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# Limited free-course offer (ISO timestamp). Enrollments are free before this,
# paid (mock checkout) afterwards. Extend/end the offer by changing this value.
FREE_OFFER_ENDS_AT=2026-10-31T00:00:00+00:00
# Outbound email (verification + reset codes). Empty = demo mode (codes
# surface in-app). For real delivery with Gmail: host smtp.gmail.com,
# port 587, user your@gmail.com, pass = App Password (Google Account >
# Security > 2-Step Verification > App passwords), from same address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NanoSphere <noreply@nanosphere.io>
